# Simulator: it shares the Mac's network stack, so localhost is correct.
# Physical phone: localhost resolves to the phone. Use the Mac's LAN address
# (`ipconfig getifaddr en0`) and start the API with --host 0.0.0.0.
# EXPO_PUBLIC_* is inlined at bundle time -- restart Metro after editing.
EXPO_PUBLIC_API_BASE=http://localhost:8011
