# THE SIMULATOR AND A PHYSICAL PHONE NEED DIFFERENT VALUES.
#
# Simulator: it shares the Mac's network stack, so localhost is correct and is the only
# thing guaranteed to route. This Mac's LAN address is a Tailscale one (100.x), which
# the simulator sandbox does NOT reach.
#
# Physical phone: localhost resolves to the phone. Change this to the Mac's real LAN
# address from `ipconfig getifaddr en0`, and start uvicorn with --host 0.0.0.0.
#
# EXPO_PUBLIC_* is inlined at bundle time, so Metro has to be restarted after editing.
EXPO_PUBLIC_API_BASE=http://localhost:8011
