.DS_Store
.venv/
__pycache__/
*.pyc

# --- derived, regenerable, or too big for git --------------------------------
# out/ is everything the pipeline builds: DSMs, shade rasters, SVF, materials, the
# routing graph. ~1 GB, rebuilt by `python -m shademe.pipeline.*`.
out/*.npy
out/*.npz
out/*.png
out/*.pkl
out/*.pkl.bak
out/v2/
out/v2_winter/
out/v2_cold/
out/day_*/
out/.provenance_cache.json
out/bench_shade_ladder*.json
!out/grid.json

# Source geojson/json fetched by shademe.pipeline.fetch and .fetch_osm.
data/*.geojson
data/*.json
data/weather_cache_*.json
# Ground-truth tables: 172 MB, re-fetched by tools/validate_sensors.py. The
# microclimate CSV alone is 162 MB, over GitHub's 100 MB per-file limit.
data/*.csv
data/isd/
data/radiation/
data/openmeteo_sites/

# --- kept, despite the rules above -------------------------------------------
# Hand-authored indoor links between arcade components. Nothing can regenerate them.
!data/connectors.json
# Hand-authored opening hours. OSM carries opening_hours on 2 of 1232 indoor ways, so
# losing this silently degrades the availability gate to "everything is always open".
!data/indoor_hours.json
# The fitted Open-Meteo bias table (~6 KB). Derived, but not regenerable from this
# repo: the fit needs the 162 MB microclimate CSV excluded above. Leaving it out makes
# a fresh clone serve the raw uncorrected feed.
!data/openmeteo_bias.json
